NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dayflow_dev
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/dayflow_test

# Phase 02 — authentication. Never commit a real secret value for any shared environment.
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# D-01 is still OPEN. Path A (admin-provisioned, POST /employees/provision) is always on.
# Path B (self-service, POST /auth/signup) stays behind this flag until D-01 is resolved.
ENABLE_SELF_SERVICE_SIGNUP=false

# Phase 06 — attendance. [RECOMMENDATION pending D-26] see modules/attendance/attendancePolicy.js.
APP_TIMEZONE=Asia/Kolkata
