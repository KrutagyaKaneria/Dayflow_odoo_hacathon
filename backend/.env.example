NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dayflow_dev
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/dayflow_test

# Phase 02 — authentication. Never commit a real secret value for any shared environment.
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# D-01 is still OPEN. Path A (admin-provisioned, POST /employees/provision) is always on.
# Path B (self-service, POST /auth/signup) stays behind this flag until D-01 is resolved.
ENABLE_SELF_SERVICE_SIGNUP=false

# Phase 06 — attendance. [RECOMMENDATION pending D-26] see modules/attendance/attendancePolicy.js.
APP_TIMEZONE=Asia/Kolkata

# Phase 10 — Security Hardening.
# FIELD_ENCRYPTION_KEY: 32 random bytes, base64-encoded (AES-256-GCM), for Bank Details
# encryption at rest — see shared/security/fieldEncryption.js. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never share the value used for a shared/production environment; rotating it makes existing
# encrypted rows unreadable (no key-rotation/re-encryption tooling is built this phase).
FIELD_ENCRYPTION_KEY=changeme
# [RECOMMENDATION] Comma-separated allow-list, replacing Phase 01's TEMP permissive CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
