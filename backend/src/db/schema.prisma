// Dayflow HRMS — schema through Phase 08 (foundational model, auth, RBAC, employee profiles,
// attendance, leave, payroll).
//
// Scope so far: organizations, users, employee_profiles (+ Phase 04's Resume/Private Info
// fields), employee_bank_details, refresh_tokens, email_verification_tokens, attendance_records
// (Phase 06), leave_requests/leave_balances/public_holidays (Phase 07), salary_structures/
// salary_components (Phase 08). Documents (D-13) belongs to a later phase and remains
// deliberately absent.
//
// Open decisions that shaped this schema — do NOT resolve them silently:
//   D-01: registration model (self-service per PDF §3.1.1 vs admin-provisioned
//         per design note) — see the `users` model comments.
//   D-21: exact employee-editable field set — see `employee_profiles` comments and
//         src/modules/employees/editPolicy.js.
// TODO(D-13): Documents section (PDF §3.3.1) — still open, deliberately not built. Neither
// source document specifies its fields, upload behavior, or storage model, and it has no
// corresponding design screen at all. No table exists for it here; do not invent one from
// nothing when a later phase picks this up — confirm the requirements first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account role. Schema only in Phase 01 — no enforcement/RBAC logic exists
/// yet (RBAC middleware is Phase 03).
enum Role {
  employee
  admin_hr
}

model Organization {
  // TODO(D-01): if the resolved signup model is pure self-service with no company concept, this
  // table may end up single-row-per-deployment or unused. Do not delete it speculatively; wait
  // for Phase 02's decision to be recorded in the Decision Register before altering.
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  logoUrl      String?  @map("logo_url") @db.VarChar(255)
  contactName  String?  @map("contact_name") @db.VarChar(255)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  users            User[]
  employeeProfiles EmployeeProfile[]
  publicHolidays   PublicHoliday[]

  @@map("organizations")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String?   @map("organization_id") @db.Uuid
  loginId            String?   @unique @map("login_id") @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  role               Role
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamp(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy        User?             @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers     User[]            @relation("UserCreatedBy")
  employeeProfile  EmployeeProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  decidedLeaveRequests    LeaveRequest[]           @relation("LeaveDecidedBy")

  // TODO(D-01): registration model (self-service per PDF §3.1.1 vs. admin-provisioned per design Note) is unresolved.
  // This schema supports either outcome:
  //   - If self-service wins: loginId/createdByUserId stay null and organization_id may go unused.
  //   - If admin-provisioned wins: login_id and created_by_user_id become required at the
  //     application layer in Phase 02.
  // Do NOT add a NOT NULL constraint to login_id or created_by_user_id until that decision is
  // recorded in the Decision Register. Same reasoning applies to organization_id nullability.
  //
  // Field provenance:
  //   password_hash      — nullable because no hashing logic exists in Phase 01; populated by Phase 02.
  //   email_verified_at  — nullable; whether unverified users can sign in is still OPEN (D-17).
  //   must_change_password — supports "system-generated password, user can change it" rule; populated in Phase 02.

  @@map("users")
}

model EmployeeProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  department     String?   @db.VarChar(255)
  managerId      String?   @map("manager_id") @db.Uuid
  location       String?   @db.VarChar(255)
  dateOfJoining  DateTime? @map("date_of_joining") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  // Phase 04 — Resume tab.
  avatarUrl String? @map("avatar_url") @db.VarChar(255)
  about     String? @db.Text
  jobLikes  String? @map("job_likes") @db.Text
  skills    Json    @default("[]")

  // Phase 04 — Private Info tab. `phone` doubles as the PDF's minimum editable set alongside
  // residing_address and avatar_url; personalEmail is deliberately separate from users.email
  // (the account/login email).
  phone            String?   @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  residingAddress  String?   @map("residing_address") @db.Text
  nationality      String?   @db.VarChar(255)
  personalEmail    String?   @map("personal_email") @db.VarChar(255)
  gender           String?   @db.VarChar(50)
  maritalStatus    String?   @map("marital_status") @db.VarChar(50)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager      EmployeeProfile?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports      EmployeeProfile[]    @relation("EmployeeManager")
  bankDetails  EmployeeBankDetails?
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  salaryStructure   SalaryStructure?

  // TODO(D-21): the exact employee-editable field set (PDF's narrow address/phone/picture vs. the
  // design's broader-looking editable icons) is resolved as a documented default in
  // src/modules/employees/editPolicy.js (EMPLOYEE_EDITABLE_FIELDS) — that file is the single
  // place to change if D-21 is decided differently. Do not add per-field permission logic here
  // or anywhere else.

  // TODO(confirm delete behavior before Phase 3+): user -> profile uses ON DELETE RESTRICT so a
  // User's Employee Profile is never cascade-deleted implicitly. Revisit once account-deletion
  // semantics are decided.

  @@map("employee_profiles")
}

/// Phase 04. One-to-one with EmployeeProfile. Admin-only editable (src/modules/employees/
/// editPolicy.js ADMIN_EDITABLE_BANK_FIELDS) — no employee-editable path exists for this table.
/// [RECOMMENDATION pending Phase 10 hardening]: accountNumber/panNo are high-sensitivity PII,
/// stored in plaintext with standard DB access controls only — see the migration comment.
model EmployeeBankDetails {
  id                String   @id @default(uuid()) @db.Uuid
  employeeProfileId String   @unique @map("employee_profile_id") @db.Uuid
  accountNumber     String?  @map("account_number") @db.VarChar(255)
  bankName          String?  @map("bank_name") @db.VarChar(255)
  ifscCode          String?  @map("ifsc_code") @db.VarChar(50)
  panNo             String?  @map("pan_no") @db.VarChar(50)
  uanNo             String?  @map("uan_no") @db.VarChar(50)
  empCode           String?  @map("emp_code") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("employee_bank_details")
}

/// Phase 02 — auth. Opaque refresh tokens are stored hashed; the raw value only ever exists
/// client-side and in the response that issued it. Rotated on every use (Security Baseline §5.5,
/// a [RECOMMENDATION] default — not stated as a requirement by either source document).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("refresh_tokens")
}

/// Phase 02 — auth, Path B (self-service signup) only. Path A (admin-provisioned) accounts set
/// users.email_verified_at directly at creation and never generate a row here.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("email_verification_tokens")
}

/// Phase 06 — attendance. All four PDF §3.4.1 values are defined from day one so no later
/// migration alters the type — 'leave' (Phase 09's Leave→Attendance sync) and 'absent'
/// (requires a working-day calendar that doesn't exist until Phase 07/08) are defined but never
/// written by this phase. See src/modules/attendance/attendancePolicy.js.
enum AttendanceStatus {
  present
  absent
  half_day
  leave
}

/// Phase 06. One row per employee per calendar date ([RECOMMENDATION pending D-25] — see the
/// unique constraint and attendancePolicy.js). Attaches to EmployeeProfile, not User, matching
/// Phase 04's precedent. ON DELETE CASCADE diverges from the SET NULL convention used for
/// *optional* FKs elsewhere in this schema — this FK is mandatory, so cascade is correct here,
/// not an inconsistency (see the migration comment).
model AttendanceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  employeeProfileId String            @map("employee_profile_id") @db.Uuid
  attendanceDate    DateTime          @map("attendance_date") @db.Date
  // Nullable since Phase 09: a LEAVE-status row written by the approval sync has no observed
  // check-in at all — see the migration comment and modules/integration/
  // syncLeaveApprovalToAttendance.js.
  checkInAt         DateTime?         @map("check_in_at") @db.Timestamptz(3)
  checkOutAt        DateTime?         @map("check_out_at") @db.Timestamptz(3)
  workHours         Decimal?          @map("work_hours") @db.Decimal(5, 2)
  extraHours        Decimal?          @map("extra_hours") @db.Decimal(5, 2)
  status            AttendanceStatus
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // TODO(D-25): drop this constraint if multi-session-per-day is adopted — see migration comment.
  @@unique([employeeProfileId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_records")
}

/// Phase 07 — leave. [PDF] and [DESIGN] agree on these three types exactly.
enum LeaveType {
  paid_time_off
  sick_leave
  unpaid_leave
}

/// Phase 07 — leave. Only the three PDF §3.5.1 values — see TODO(D-33) on LeaveRequest: no
/// CANCELLED state exists, and neither source describes one.
enum LeaveStatus {
  pending
  approved
  rejected
}

/// Phase 07. Attaches to EmployeeProfile, matching Phase 06's AttendanceRecord precedent.
/// ON DELETE CASCADE for the same reason as AttendanceRecord — a leave request is meaningless
/// without its employee. days_used/days_pending are NOT columns anywhere in this schema — see
/// leavePolicy.js; they are derived by aggregating rows of this table at read time.
model LeaveRequest {
  id                String      @id @default(uuid()) @db.Uuid
  employeeProfileId String      @map("employee_profile_id") @db.Uuid
  leaveType         LeaveType   @map("leave_type")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  daysCount         Decimal     @map("days_count") @db.Decimal(6, 2)
  status            LeaveStatus @default(pending)
  remarks           String?     @db.Text
  attachmentUrl     String?     @map("attachment_url") @db.VarChar(255)
  adminComment      String?     @map("admin_comment") @db.Text
  decidedByUserId   String?     @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedByUser   User?           @relation("LeaveDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // TODO(D-33): employee cancellation/edit of a PENDING request is not built — no CANCELLED
  // state exists. Adding one later is an enum migration, not a config change.
  @@index([employeeProfileId, startDate])
  @@index([status])
  @@map("leave_requests")
}

/// Phase 07. One row per employee per leave type; unpaid_leave deliberately has no row (it is
/// unbounded by definition — see leavePolicy.js seeding notes). Read-only from the Admin
/// Allocation tab this phase (D-09).
model LeaveBalance {
  id                String    @id @default(uuid()) @db.Uuid
  employeeProfileId String    @map("employee_profile_id") @db.Uuid
  leaveType         LeaveType @map("leave_type")
  daysAllocated     Decimal   @map("days_allocated") @db.Decimal(5, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([employeeProfileId, leaveType])
  @@map("leave_balances")
}

/// Phase 07. [RECOMMENDATION pending D-11] organizationId nullable: NULL = global/default
/// holiday set. Seeded (not migrated) with the design's nine India-specific 2026 dates — see
/// src/db/seeds/dev-seed.js.
model PublicHoliday {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  holidayDate    DateTime      @map("holiday_date") @db.Date
  name           String        @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([holidayDate])
  @@map("public_holidays")
}

/// Phase 08 — payroll. [DESIGN] shows only "Fixed wage"; a one-value enum means adding another
/// wage type later is a value change, not a type change.
enum SalaryWageType {
  fixed
}

/// Phase 08. Distinguishes the three money directions D-34/D-36 depend on — not named by either
/// source, [INFERENCE], but required for any coherent gross/net split.
enum SalaryComponentKind {
  earning
  deduction_employee
  contribution_employer
}

enum SalaryComputationType {
  fixed_amount
  percentage
}

/// Phase 08 — D-35. What a percentage component is a percentage OF. Per-component, not global —
/// see payrollPolicy.js for why the design's own figures demonstrate a mixed base.
enum SalaryPercentageBase {
  wage
  basic
}

/// Phase 08. One structure per employee (unique FK) — D-22's overwrite-in-place default, no
/// versioning, no history table. workingDaysPerWeek/breakTimeHours are captured here but
/// deliberately consumed by NOTHING this phase — payable-days is Phase 09 (D-12), and neither
/// Phase 06's totalWorkingDays stub nor Phase 07's EXCLUDE_WEEKENDS_FROM_DAY_COUNT default are
/// touched.
model SalaryStructure {
  id                  String         @id @default(uuid()) @db.Uuid
  employeeProfileId   String         @unique @map("employee_profile_id") @db.Uuid
  wageType            SalaryWageType @default(fixed) @map("wage_type")
  monthlyWage         Decimal        @map("monthly_wage") @db.Decimal(12, 2)
  yearlyWage          Decimal        @map("yearly_wage") @db.Decimal(12, 2)
  workingDaysPerWeek  Decimal?       @map("working_days_per_week") @db.Decimal(3, 1)
  breakTimeHours      Decimal?       @map("break_time_hours") @db.Decimal(4, 2)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeProfile EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  components      SalaryComponent[]

  @@map("salary_structures")
}

/// Phase 08. PF (employee/employer) and Professional Tax are ROWS here (componentKind
/// distinguishes them), not bespoke columns — see routes.js. Computed rupee amounts are NEVER
/// stored — calculateSalary.js derives them at read time from `value` + computationType +
/// percentageBase, matching the derived-not-stored precedent from Phase 06/07.
model SalaryComponent {
  id                String                 @id @default(uuid()) @db.Uuid
  salaryStructureId String                 @map("salary_structure_id") @db.Uuid
  name              String                 @db.VarChar(255)
  componentKind     SalaryComponentKind    @map("component_kind")
  computationType   SalaryComputationType  @map("computation_type")
  percentageBase    SalaryPercentageBase?  @map("percentage_base")
  // Identifies which SINGLE component is "Basic" — see the migration comment. At most one true
  // per structure, enforced by a partial unique index.
  isBasic           Boolean                @default(false) @map("is_basic")
  value             Decimal                @db.Decimal(8, 4)
  description       String?                @db.Text
  displayOrder      Int                    @map("display_order")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([salaryStructureId])
  @@map("salary_components")
}
