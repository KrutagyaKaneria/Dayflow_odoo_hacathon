// Dayflow HRMS — schema through Phase 04 (foundational model, auth, RBAC, employee profiles).
//
// Scope so far: organizations, users, employee_profiles (+ Phase 04's Resume/Private Info
// fields), employee_bank_details, refresh_tokens, email_verification_tokens. Attendance, Leave,
// Salary, and Documents belong to later phases and are deliberately absent here.
//
// Open decisions that shaped this schema — do NOT resolve them silently:
//   D-01: registration model (self-service per PDF §3.1.1 vs admin-provisioned
//         per design note) — see the `users` model comments.
//   D-21: exact employee-editable field set — see `employee_profiles` comments and
//         src/modules/employees/editPolicy.js.
// TODO(D-13): Documents section (PDF §3.3.1) — still open, deliberately not built. Neither
// source document specifies its fields, upload behavior, or storage model, and it has no
// corresponding design screen at all. No table exists for it here; do not invent one from
// nothing when a later phase picks this up — confirm the requirements first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account role. Schema only in Phase 01 — no enforcement/RBAC logic exists
/// yet (RBAC middleware is Phase 03).
enum Role {
  employee
  admin_hr
}

model Organization {
  // TODO(D-01): if the resolved signup model is pure self-service with no company concept, this
  // table may end up single-row-per-deployment or unused. Do not delete it speculatively; wait
  // for Phase 02's decision to be recorded in the Decision Register before altering.
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  logoUrl      String?  @map("logo_url") @db.VarChar(255)
  contactName  String?  @map("contact_name") @db.VarChar(255)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  users            User[]
  employeeProfiles EmployeeProfile[]

  @@map("organizations")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String?   @map("organization_id") @db.Uuid
  loginId            String?   @unique @map("login_id") @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  role               Role
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamp(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy        User?             @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers     User[]            @relation("UserCreatedBy")
  employeeProfile  EmployeeProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]

  // TODO(D-01): registration model (self-service per PDF §3.1.1 vs. admin-provisioned per design Note) is unresolved.
  // This schema supports either outcome:
  //   - If self-service wins: loginId/createdByUserId stay null and organization_id may go unused.
  //   - If admin-provisioned wins: login_id and created_by_user_id become required at the
  //     application layer in Phase 02.
  // Do NOT add a NOT NULL constraint to login_id or created_by_user_id until that decision is
  // recorded in the Decision Register. Same reasoning applies to organization_id nullability.
  //
  // Field provenance:
  //   password_hash      — nullable because no hashing logic exists in Phase 01; populated by Phase 02.
  //   email_verified_at  — nullable; whether unverified users can sign in is still OPEN (D-17).
  //   must_change_password — supports "system-generated password, user can change it" rule; populated in Phase 02.

  @@map("users")
}

model EmployeeProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  department     String?   @db.VarChar(255)
  managerId      String?   @map("manager_id") @db.Uuid
  location       String?   @db.VarChar(255)
  dateOfJoining  DateTime? @map("date_of_joining") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  // Phase 04 — Resume tab.
  avatarUrl String? @map("avatar_url") @db.VarChar(255)
  about     String? @db.Text
  jobLikes  String? @map("job_likes") @db.Text
  skills    Json    @default("[]")

  // Phase 04 — Private Info tab. `phone` doubles as the PDF's minimum editable set alongside
  // residing_address and avatar_url; personalEmail is deliberately separate from users.email
  // (the account/login email).
  phone            String?   @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  residingAddress  String?   @map("residing_address") @db.Text
  nationality      String?   @db.VarChar(255)
  personalEmail    String?   @map("personal_email") @db.VarChar(255)
  gender           String?   @db.VarChar(50)
  maritalStatus    String?   @map("marital_status") @db.VarChar(50)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager      EmployeeProfile?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports      EmployeeProfile[]    @relation("EmployeeManager")
  bankDetails  EmployeeBankDetails?

  // TODO(D-21): the exact employee-editable field set (PDF's narrow address/phone/picture vs. the
  // design's broader-looking editable icons) is resolved as a documented default in
  // src/modules/employees/editPolicy.js (EMPLOYEE_EDITABLE_FIELDS) — that file is the single
  // place to change if D-21 is decided differently. Do not add per-field permission logic here
  // or anywhere else.

  // TODO(confirm delete behavior before Phase 3+): user -> profile uses ON DELETE RESTRICT so a
  // User's Employee Profile is never cascade-deleted implicitly. Revisit once account-deletion
  // semantics are decided.

  @@map("employee_profiles")
}

/// Phase 04. One-to-one with EmployeeProfile. Admin-only editable (src/modules/employees/
/// editPolicy.js ADMIN_EDITABLE_BANK_FIELDS) — no employee-editable path exists for this table.
/// [RECOMMENDATION pending Phase 10 hardening]: accountNumber/panNo are high-sensitivity PII,
/// stored in plaintext with standard DB access controls only — see the migration comment.
model EmployeeBankDetails {
  id                String   @id @default(uuid()) @db.Uuid
  employeeProfileId String   @unique @map("employee_profile_id") @db.Uuid
  accountNumber     String?  @map("account_number") @db.VarChar(255)
  bankName          String?  @map("bank_name") @db.VarChar(255)
  ifscCode          String?  @map("ifsc_code") @db.VarChar(50)
  panNo             String?  @map("pan_no") @db.VarChar(50)
  uanNo             String?  @map("uan_no") @db.VarChar(50)
  empCode           String?  @map("emp_code") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("employee_bank_details")
}

/// Phase 02 — auth. Opaque refresh tokens are stored hashed; the raw value only ever exists
/// client-side and in the response that issued it. Rotated on every use (Security Baseline §5.5,
/// a [RECOMMENDATION] default — not stated as a requirement by either source document).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("refresh_tokens")
}

/// Phase 02 — auth, Path B (self-service signup) only. Path A (admin-provisioned) accounts set
/// users.email_verified_at directly at creation and never generate a row here.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("email_verification_tokens")
}
